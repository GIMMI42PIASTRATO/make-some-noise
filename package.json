{
	"name": "make-some-noise",
	"version": "1.0.0",
	"description": "Discord Soundboard Bot - Play sounds in voice channels",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"check": "tsc --noEmit --project tsconfig.json",
		"start": "tsx src/index.ts",
		"dev": "tsx watch src/index.ts",
		"deploy": "tsx src/deploy-commands.ts"
	},
	"keywords": [
		"discord",
		"bot",
		"soundboard",
		"voice"
	],
	"author": "",
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@discordjs/opus": "^0.10.0",
		"@discordjs/voice": "^0.19.0",
		"discord.js": "^14.22.1",
		"dotenv": "^17.2.1",
		"ffmpeg-static": "^5.2.0",
		"libsodium-wrappers": "^0.7.15",
		"sodium-native": "^5.0.6"
	},
	"devDependencies": {
		"@types/node": "^24.3.1",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2"
	}
}
